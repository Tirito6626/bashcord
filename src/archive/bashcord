IFS=$'\n'

initialized=false
function startClient {
if [[ "$client_json" = "" ]]; then
echo "Client is not ready. Use ClientBuilder for intialization"
exit
fi
client=$(bot)
 echo "Starting bashcord v${ver} as $(echo $output3 | ${jq_binary} -r '.bot.username + "#" + .bot.discriminator')"
event fire "ready" 
payload=$(cat <<- EOF
{ "op": 2, "d": $(echo "$client_json" | ${jq_binary} -c '.') }
EOF
)

 "${respondOnBots:=false}" || respondOnBots=null 
while true; do
  start=true
  [ ! -z $WEBSOCKET_PID ] && kill -0 $WEBSOCKET_PID && kill -s TERM $WEBSOCKET_PID # checks if old process is still running
  coproc WEBSOCKET { ${websocat_binary} --no-close "wss://gateway.discord.gg/?v=10&encoding=json"; } # creates new co-process on background
  sleep 1
  echo "$payload" >&"${WEBSOCKET[1]}" # authorization
  sleep 3
  [ -z "$heartbeat_PID" ] && coproc heartbeat { heartbeat; } # check if heartbeat function is running, if not, start it
  while read line <&"${WEBSOCKET[0]}"; do # read from websocket
    if [ ! -z "$line" ]; then
      local output=$(echo "$line" | ${jq_binary} -rc '.t')
      local output2=$(echo "$line" | ${jq_binary} -rc '.op')
      local output3=$(echo "$line" | ${jq_binary} -rc '.d')
# uncomment for debugging only
      echo -e "Event name: $output"
      echo -e "OP code: $output2"
 # echo -e "Data: $output3"
      case $output2 in
      11)
        read -r time1 <&"${heartbeat[0]}"
        latency=$(($(date +%s%3N)-time1))
        echo "$latency"
      ;;
      7) 
# OP code 7 means client should either resume (I tried implementing it, without success) or reconnect
        break # restart loop
      ;;
      9)
        echo "Session is invalid. Try to check your code on errors"
        echo "If your code is correct and you see this, write about that in bashcord discord server"
        break 2
