function functionLoader {
"$verbose" && echo "Loading functions..."
  for folder in application bot channel guild guild-template interaction invite sticker user audit-log
  do 
  for function in $(find "${LOCATION}functions/${folder}/" -maxdepth 1 -type f  )
  do
  source ${function}
  function2=${function##*/}
  export -f "${function2//\.sh/}"
  done
  done
}

function builderLoader {
  "$verbose" && echo "Loading builders..."
  for file in client.sh activity.sh message.sh embed.sh action_row.sh application_command.sh
  do 
  [ ! -f "${LOCATION}builders/${file}" ] && error "${file} couldn't be found (${LOCATION}builders/${file})"
  source "${LOCATION}builders/${file}"
  done 
}

function warn {
