heartbeat() {
sleep 3
while true; do 
  echo '{ "op": 1, "d": null }' >&"${WEBSOCKET[1]}"
  if (( $? > 0 )); then
    kill $WEBSOCKET_PID $(pgrep -P $WEBSOCKET_PID)
  fi
  echo "$(date +%s%3N)"
  sleep 42
done 
}

# start of the client
functionLoader 
